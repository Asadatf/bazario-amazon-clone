# Copy to .env. Every variable is validated at startup (src/config/env.ts); the app refuses to boot if one is invalid.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/bazario?schema=public

# Long random strings. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated list of browser origins allowed to call the API with credentials.
WEB_ORIGINS=http://localhost:3000
# true in production (HTTPS). When true the refresh cookie is sent as SameSite=None; Secure for cross-site deploys.
COOKIE_SECURE=false

# Requests per minute per IP on /auth/login and /auth/register.
AUTH_THROTTLE_LIMIT=5

# mock | stripe
PAYMENT_PROVIDER=mock
# HMAC secret the mock provider signs its webhooks with.
MOCK_WEBHOOK_SECRET=change-me-mock-webhook-secret
# Only required when PAYMENT_PROVIDER=stripe (test mode keys: sk_test_..., whsec_..., pk_test_...).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
